// use prisma-next

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String?  @unique
  name      String?
  passwordHash String
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  languages       UserLanguage[]
  courseProgress  UserCourseProgress[]
  courses              UserCourse[]
  lessonProgress       UserLessonProgress[]
  exerciseAttempts     UserExerciseAttempt[]
  vocabularyProgress   UserVocabularyProgress[]
}

model Language {
  id                    Int                      @id @default(autoincrement())
  code                  String                   @unique
  name                  String
  nativeName            String
  direction             String
  isActive              Boolean                  @default(true)
  variants              LanguageVariant[]
  vocabularies          Vocabulary[]
  vocabularyTranslations VocabularyTranslation[]
  createdAt             TimestamptzString        @default(now())
  updatedAt             temporal.updatedAtString()
}

model LanguageVariant {
  id           Int              @id @default(autoincrement())
  language     Language         @relation(fields: [languageId], references: [id])
  languageId   Int
  code         String
  name         String
  nativeName   String
  region       String?
  description  String?
  isActive     Boolean          @default(true)
  courses      Course[]
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()

  @@unique([languageId, code])
}

model LanguageName {
  id          Int      @id @default(autoincrement())
  languageId  Int
  locale      String
  name        String

  language Language @relation(fields: [languageId], references: [id])
}

model UserLanguage {
  id          Int      @id @default(autoincrement())
  userId      Int
  languageId Int
  role        String
  createdAt   TimestamptzString @default(now())

  user     User     @relation(fields: [userId], references: [id])
  language Language @relation(fields: [languageId], references: [id])
}

model Course {
  id                Int              @id @default(autoincrement())
  languageVariant   LanguageVariant  @relation(fields: [languageVariantId], references: [id])
  languageVariantId Int
  code              String
  title             String
  description       String?
  level             String
  isActive          Boolean          @default(true)
  units             Unit[]
  createdAt         TimestamptzString @default(now())
  updatedAt         temporal.updatedAtString()
  enrollments UserCourse[]

  @@unique([languageVariantId, code])
}

model Lesson {
  id               Int                @id @default(autoincrement())
  unit             Unit               @relation(fields: [unitId], references: [id])
  unitId           Int
  number           Int
  title            String
  description      String?
  type             String
  isActive         Boolean            @default(true)
  exercises        Exercise[]
  vocabulary       LessonVocabulary[]
  createdAt        TimestamptzString  @default(now())
  updatedAt        temporal.updatedAtString()
  userProgress UserLessonProgress[]

  @@unique([unitId, number])
}

model LessonVocabulary {
  id           Int              @id @default(autoincrement())
  lesson       Lesson           @relation(fields: [lessonId], references: [id])
  lessonId     Int
  vocabulary   Vocabulary       @relation(fields: [vocabularyId], references: [id])
  vocabularyId Int
  position     Int
  isRequired   Boolean          @default(true)
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()

  @@unique([lessonId, vocabularyId])
  @@unique([lessonId, position])
}

model Vocabulary {
  id                    Int                      @id @default(autoincrement())
  language              Language                 @relation(fields: [languageId], references: [id])
  languageId            Int
  word                  String
  normalizedWord        String
  pronunciation         String?
  partOfSpeech          String?
  definition            String?
  audioUrl              String?
  imageUrl              String?
  translations          VocabularyTranslation[]
  lessons               LessonVocabulary[]
  createdAt             TimestamptzString        @default(now())
  updatedAt             temporal.updatedAtString()
  progress UserVocabularyProgress[]

  @@unique([languageId, normalizedWord])
}

model VocabularyTranslation {
  id             Int              @id @default(autoincrement())
  vocabulary     Vocabulary       @relation(fields: [vocabularyId], references: [id])
  vocabularyId   Int
  language       Language         @relation(fields: [languageId], references: [id])
  languageId     Int
  translation    String
  normalizedTranslation String
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()

  @@unique([vocabularyId, languageId])
}

model Exercise {
  id          Int               @id @default(autoincrement())
  lesson      Lesson            @relation(fields: [lessonId], references: [id])
  lessonId    Int
  number      Int
  type        String
  question   String
  explanation String?
  answer      String?
  points      Int               @default(10)
  isActive    Boolean           @default(true)
  options     ExerciseOption[]
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
  attempts UserExerciseAttempt[]

  @@unique([lessonId, number])
}

model ExerciseOption {
  id         Int              @id @default(autoincrement())
  exercise   Exercise         @relation(fields: [exerciseId], references: [id])
  exerciseId Int
  value      String
  label      String?
  isCorrect  Boolean          @default(false)
  number     Int
  createdAt  TimestamptzString @default(now())
  updatedAt  temporal.updatedAtString()

  @@unique([exerciseId, number])
}

model UserExerciseAttempt {
  id          Int              @id @default(autoincrement())
  user        User             @relation(fields: [userId], references: [id])
  userId      Int
  exercise    Exercise         @relation(fields: [exerciseId], references: [id])
  exerciseId  Int
  answer      String?
  isCorrect   Boolean
  score       Int              @default(0)
  attemptedAt TimestamptzString @default(now())
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
}

model UserCourse {
  id           Int              @id @default(autoincrement())
  user         User             @relation(fields: [userId], references: [id])
  userId       Int
  course       Course           @relation(fields: [courseId], references: [id])
  courseId     Int
  status       String           @default("active")
  progress     Int              @default(0)
  startedAt    TimestamptzString @default(now())
  completedAt  TimestamptzString?
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()

  @@unique([userId, courseId])
}

model UserCourseProgress {
  id          Int      @id @default(autoincrement())
  userId      Int
  courseId    Int
  progress    Int      @default(0)
  completed   Boolean  @default(false)
  updatedAt   temporal.updatedAtString()

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
}

model UserLessonProgress {
  id          Int              @id @default(autoincrement())
  user        User             @relation(fields: [userId], references: [id])
  userId      Int
  lesson      Lesson           @relation(fields: [lessonId], references: [id])
  lessonId    Int
  status      String           @default("not_started")
  progress    Int              @default(0)
  score       Int              @default(0)
  startedAt   TimestamptzString?
  completedAt TimestamptzString?
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  @@unique([userId, lessonId])
}

model UserVocabularyProgress {
  id             Int              @id @default(autoincrement())
  user           User             @relation(fields: [userId], references: [id])
  userId         Int
  vocabulary     Vocabulary       @relation(fields: [vocabularyId], references: [id])
  vocabularyId   Int
  status         String           @default("learning")
  strength       Int              @default(0)
  correctCount   Int              @default(0)
  incorrectCount Int              @default(0)
  lastReviewedAt TimestamptzString?
  nextReviewAt   TimestamptzString?
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()

  @@unique([userId, vocabularyId])
}

model Unit {
  id          Int              @id @default(autoincrement())
  course      Course           @relation(fields: [courseId], references: [id])
  courseId    Int
  number      Int
  title       String
  description String?
  isActive    Boolean          @default(true)
  lessons     Lesson[]
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  @@unique([courseId, number])
}